# Copy to .env and fill in the current ngrok tunnel URL. On the free ngrok
# plan this changes every time the tunnel restarts — ask for the current one
# if API calls start failing with a connection error. After editing, restart
# the dev server with `npx expo start --clear` to pick up the new value.
EXPO_PUBLIC_API_BASE_URL=https://your-ngrok-url.ngrok-free.dev
